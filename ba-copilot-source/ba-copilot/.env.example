# Sao chép tệp này thành .env rồi điền khoá. .env đã nằm trong .gitignore nên không bị đưa lên Git.
# Để trống cả hai khoá thì app chạy Chế độ Mock (bộ sinh rule-based, không cần Internet).

# Cách 1 – gọi thẳng Anthropic: dán API key lấy ở platform.claude.com
ANTHROPIC_API_KEY=

# Cách 2 – đi qua cổng trung gian: khoá gửi dạng "Authorization: Bearer", kèm địa chỉ cổng
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=https://ten-cong.example.com

ANTHROPIC_MODEL=claude-sonnet-4-5

# Tuỳ chọn
# MAX_AI_CALLS_PER_DAY=200     # giới hạn số lượt gọi Claude mỗi ngày
# APP_PASSWORD=                # đặt khi deploy công khai: mọi trang yêu cầu mật khẩu
# GITHUB_TOKEN=                # token GitHub mặc định khi dự án chưa nhập token riêng
# AI_MODE=mock                 # ép chạy Mock dù đã có khoá
