{
  "name": "ba-copilot",
  "version": "0.1.0",
  "private": true,
  "description": "BA Copilot – hệ thống hỗ trợ BA: Prompt → Thiết kế UI → UC/SRS/Sequence → Test case → Truy vết",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --watch & tsx watch server/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check-vi": "node scripts/check-vi.mjs",
    "e2e": "node scripts/build.mjs && node e2e/e2e.mjs",
    "seed": "tsx scripts/seed.ts",
    "erd": "tsx scripts/erd.ts",
    "export-db": "tsx scripts/export-db.ts",
    "bundle": "node scripts/bundle.mjs",
    "start:prebuilt": "node dist/server.mjs",
    "build-corpus": "tsx scripts/build-corpus.ts",
    "build-model": "tsx scripts/build-next-model.ts",
    "eval-next": "tsx scripts/eval-next.ts",
    "build-synthetic": "tsx scripts/build-synthetic.ts",
    "dataset:validate": "tsx scripts/dataset/validate-roots.ts dataset/roots/*.json",
    "dataset:samples": "tsx scripts/dataset/build-samples.ts"
  },
  "dependencies": {
    "docx": "^9.6.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.60.0",
    "mermaid": "^11.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.21.0",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.27.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0"
  }
}
